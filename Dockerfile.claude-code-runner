# Build image for claude-code-runner: the Go shell plus the Claude Code CLI it
# drives.
#
# Unlike the other images here this cannot be distroless. The runner execs a
# Node-based CLI which in turn runs git and shell commands inside the working
# tree, so the final stage needs a real userland — Node, git, and a shell.
FROM golang:1.26 AS builder
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -a -o claude-code-runner ./cmd/claude-code-runner

FROM node:22-bookworm-slim

# git is not optional: the agent's whole job is editing a checkout and pushing
# branches. ca-certificates is needed for HTTPS remotes and the model API.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Pin the CLI so an image rebuild is reproducible; bump this deliberately rather
# than letting @latest change what a rebuilt tag contains.
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
 && npm cache clean --force

COPY --from=builder /workspace/claude-code-runner /usr/local/bin/claude-code-runner

# The working tree is a mounted PVC owned by this uid. node:22 ships a non-root
# "node" user (uid 1000); running as it keeps the agent from writing anywhere
# outside what it was given.
USER node
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/claude-code-runner"]
