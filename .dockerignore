# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include the coding-agent image's non-Go build inputs. That image is not a Go
# build at all — it is opencode plus a plugin — so without these the COPY steps
# fail with "not found", which reads like a missing file rather than an exclusion.
!hack/coding-agent-entrypoint.sh
# A locally packed plugin tarball, for testing a change before publishing it
# (see PLUGIN_TARBALL in Dockerfile.coding-agent). Unused in a release build.
!*.tgz

# The models catalog, copied from a local opencode cache for offline builds
# (see MODELS_CATALOG in Dockerfile.coding-agent). Not part of a release build.
!models-catalog.json
