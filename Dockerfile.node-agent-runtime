# cmd/node-agent-runtime — an Agent Plane runtime built on the Vercel AI SDK
# (docs/runtime-protocol.md), as an alternative to cmd/agent-runtime (Go) for
# providers/models the AI SDK handles more robustly out of the box (separate
# reasoning/content fields, multi-provider support).
FROM docker.io/library/node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY src/ ./src/
USER node
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["node", "src/main.js"]
