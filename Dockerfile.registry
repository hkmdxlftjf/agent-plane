# Build image for the Registry (data-plane config endpoint).
FROM golang:1.26 AS builder
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY internal/ internal/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -a -o registry ./cmd/registry

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/registry .
USER 65532:65532
ENTRYPOINT ["/registry"]
CMD ["--addr", ":9090"]
